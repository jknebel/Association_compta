rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function authEmail() {
      return ('email' in request.auth.token) ? request.auth.token.email.lower() : '';
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('superAdmin', false) == true
        || authEmail() in ['jean.francois.knebel@gmail.com', 'jean-francois@knebel.ch']
      );
    }

    function normRole(value) {
      return value is string ? value.trim().lower() : '';
    }

    function isApprovedMemberDoc(data) {
      return data.get('status', 'approved') == 'approved';
    }

    function orgMemberPathByUid(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function orgMemberPathByEmail(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(authEmail());
    }

    function comptaMemberPath(orgId, comptaId) {
      return /databases/$(database)/documents/organizations/$(orgId)/comptabilites/$(comptaId)/members/$(request.auth.uid);
    }

    function comptaSubRole(orgId, comptaId) {
      let path = comptaMemberPath(orgId, comptaId);
      return exists(path)
        ? ('role' in get(path).data ? normRole(get(path).data.role) : 'comptable')
        : '';
    }

    // comptaAccess peut être absent ou null sur d'anciennes fiches : on retombe alors sur une map vide
    function comptaAccessOf(data) {
      return data.get('comptaAccess', {}) is map ? data.get('comptaAccess', {}) : {};
    }

    function orgMemberAccessRole(path, comptaId) {
      return exists(path) && isApprovedMemberDoc(get(path).data)
        ? normRole(comptaAccessOf(get(path).data).get(comptaId, ''))
        : '';
    }

    function orgMemberOrgRole(path) {
      return exists(path) && isApprovedMemberDoc(get(path).data)
        ? normRole(get(path).data.get('role', ''))
        : '';
    }

    function isOrgAdmin(orgId) {
      return isSuperAdmin()
        || orgMemberOrgRole(orgMemberPathByUid(orgId)) == 'admin'
        || (authEmail() != '' && orgMemberOrgRole(orgMemberPathByEmail(orgId)) == 'admin');
    }

    function hasRoleOnCompta(orgId, comptaId, allowedRoles) {
      return comptaSubRole(orgId, comptaId) in allowedRoles
        || orgMemberAccessRole(orgMemberPathByUid(orgId), comptaId) in allowedRoles
        || (authEmail() != '' && orgMemberAccessRole(orgMemberPathByEmail(orgId), comptaId) in allowedRoles);
    }

    function isComptaAccountingWriter(orgId, comptaId) {
      return isAuthenticated() && (
        isOrgAdmin(orgId)
        || hasRoleOnCompta(orgId, comptaId, ['caissier', 'comptable', 'admin'])
      );
    }

    function isComptaVerificateur(orgId, comptaId) {
      return isAuthenticated()
        && hasRoleOnCompta(orgId, comptaId, ['verificateur']);
    }

    function isComptaViewer(orgId, comptaId) {
      return isAuthenticated()
        && hasRoleOnCompta(orgId, comptaId, ['viewer']);
    }

    function isComptaRentalManager(orgId, comptaId) {
      return isAuthenticated() && (
        orgMemberOrgRole(orgMemberPathByUid(orgId)) in ['responsable_location', 'location']
        || (authEmail() != '' && orgMemberOrgRole(orgMemberPathByEmail(orgId)) in ['responsable_location', 'location'])
        || hasRoleOnCompta(orgId, comptaId, ['responsable_location', 'location'])
      );
    }

    function isComptaUploader(orgId, comptaId) {
      return isAuthenticated()
        && hasRoleOnCompta(orgId, comptaId, ['uploader']);
    }

    function canReadCompta(orgId, comptaId) {
      return isComptaAccountingWriter(orgId, comptaId)
        || isComptaVerificateur(orgId, comptaId)
        || isComptaViewer(orgId, comptaId);
    }

    function hasOrgCaissierDoc(path) {
      return exists(path)
        && isApprovedMemberDoc(get(path).data)
        && (
          normRole(get(path).data.get('role', '')) in ['caissier', 'comptable']
          || comptaAccessOf(get(path).data).values().hasAny(['caissier', 'comptable', 'admin'])
        );
    }

    function isOrgCaissier(orgId) {
      return isOrgAdmin(orgId)
        || hasOrgCaissierDoc(orgMemberPathByUid(orgId))
        || (authEmail() != '' && hasOrgCaissierDoc(orgMemberPathByEmail(orgId)));
    }

    // Conservation temporaire pour create/members au niveau org (durcissement dédié dans SEC-02)
    function hasAnyOrgComptaAccess(path) {
      return exists(path)
        && isApprovedMemberDoc(get(path).data)
        && comptaAccessOf(get(path).data).size() > 0;
    }

    function hasUploaderRole(orgId, comptaId) {
      return hasRoleOnCompta(orgId, comptaId, ['uploader']);
    }

    // true si l'utilisateur est "uploader" sur cette comptabilité et n'a aucun rôle supérieur
    function isUploaderOnly(orgId, comptaId) {
      return isAuthenticated()
        && !isSuperAdmin()
        && hasUploaderRole(orgId, comptaId)
        && !isOrgAdmin(orgId);
    }

    // Un uploader ne peut pas modifier son propre profil membre (anti-élévation de privilèges)
    function isRestrictedSelfMember(memberId) {
      return !isSuperAdmin()
        && (memberId == request.auth.uid || (authEmail() != '' && memberId == authEmail()))
        && resource.data.get('role', '') != 'admin'
        && comptaAccessOf(resource.data).values().hasAny(['uploader']);
    }

    // Demande d'adhésion initiale par un nouvel inscrit (uniquement pour soi-même, sans rôle admin ni accès compta)
    function isSafeSelfJoinRequest(memberId) {
      let data = request.resource.data;
      return memberId == request.auth.uid
        && normRole(data.get('role', 'member')) != 'admin'
        && comptaAccessOf(data).size() == 0;
    }

    // Mise à jour de son propre profil membre sans modifier son rôle ni ses accès comptables
    function isSafeSelfMemberUpdate(memberId) {
      return (memberId == request.auth.uid || (authEmail() != '' && memberId == authEmail()))
        && !isRestrictedSelfMember(memberId)
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && comptaAccessOf(request.resource.data) == comptaAccessOf(resource.data);
    }

    // Contraintes sur un justificatif créé par un uploader : rattaché à son auteur, jamais pré-traité
    function isValidUploaderReceipt() {
      let data = request.resource.data;
      return data.get('submittedByUid', '') == request.auth.uid
        && !data.keys().hasAny(['reimbursedAt', 'reimbursedByUid', 'reimbursedByName', 'transferRequest', 'transferHistory'])
        && data.get('reimbursementStatus', null) in ['PENDING', null]
        && data.get('linkedTransactionId', null) == null;
    }

    // Allow all authenticated users to read user profiles (needed for member/role assignment),
    // and only the owner to write their own profile (or auto-purge of unverified robot accounts).
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && (
        isOwner(userId) ||
        (resource.data.emailVerificationRequired == true && resource.data.emailVerified == false)
      );
      
      // Allow access to personal subcollections (legacy accounts, transactions, receipts) only to owner
      match /{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Phase 2 : Organisations
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        isOrgAdmin(orgId)
        || hasAnyOrgComptaAccess(orgMemberPathByUid(orgId))
        || (authEmail() != '' && hasAnyOrgComptaAccess(orgMemberPathByEmail(orgId)))
      );

      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          isOrgAdmin(orgId)
          || isSafeSelfJoinRequest(memberId)
          || hasAnyOrgComptaAccess(orgMemberPathByUid(orgId))
        );
        allow update: if isAuthenticated() && (
          isOrgAdmin(orgId)
          || isSafeSelfMemberUpdate(memberId)
        );
        allow delete: if isAuthenticated() && isOrgAdmin(orgId);
      }

      match /invitations/{inviteId} {
        allow read, write: if isAuthenticated();
      }

      match /comptabilites/{comptaId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && isOrgCaissier(orgId)
          && request.resource.data.get('createdBy', '') == request.auth.uid;
        allow update, delete: if isComptaAccountingWriter(orgId, comptaId);

        // Écritures bancaires : lecture autorisée pour caissier/vérificateur/lecteur uniquement ;
        // écriture complète pour caissier/admin ; propositions & commentaires encadrés pour vérificateur/lecteur.
        match /transactions/{txId} {
          allow read: if canReadCompta(orgId, comptaId);
          allow create, delete: if isComptaAccountingWriter(orgId, comptaId);
          allow update: if isComptaAccountingWriter(orgId, comptaId)
            || (
              isComptaVerificateur(orgId, comptaId)
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['amount', 'date', 'id', 'runningBalance'])
            )
            || (
              isComptaViewer(orgId, comptaId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
            );
        }

        // Sous-collections génériques (accounts, settings, categories, notifications...)
        // Un "uploader" ne peut lire que 'accounts' pour préparer un dépôt, et ne peut rien écrire.
        match /{sub}/{docId=**} {
          allow read: if isAuthenticated()
            && sub != 'receipts'
            && sub != 'transactions'
            && sub != 'members'
            && sub != 'rentals'
            && (
              canReadCompta(orgId, comptaId)
              || (sub == 'accounts' && (isComptaUploader(orgId, comptaId) || isComptaRentalManager(orgId, comptaId)))
            );
          allow write: if sub != 'receipts'
            && sub != 'transactions'
            && sub != 'members'
            && sub != 'rentals'
            && (
              isComptaAccountingWriter(orgId, comptaId)
              || (sub == 'notifications' && isComptaRentalManager(orgId, comptaId))
            );
        }

        // Membres de la comptabilité (rôles) : gestion réservée aux caissiers/admins (jamais d'auto-promotion)
        match /members/{memberUid} {
          allow read: if isAuthenticated() && (
            canReadCompta(orgId, comptaId)
            || isComptaUploader(orgId, comptaId)
            || isComptaRentalManager(orgId, comptaId)
            || request.auth.uid == memberUid
          );
          allow create: if request.resource != null && (
            isComptaAccountingWriter(orgId, comptaId)
            || (
              isOrgCaissier(orgId)
              && request.auth.uid == memberUid
              && get(/databases/$(database)/documents/organizations/$(orgId)/comptabilites/$(comptaId)).data.get('createdBy', '') == request.auth.uid
            )
          ) && normRole(request.resource.data.get('role', '')) in [
            'caissier', 'comptable', 'verificateur', 'viewer', 'uploader', 'responsable_location', 'location'
          ];
          allow update: if request.resource != null
            && isComptaAccountingWriter(orgId, comptaId)
            && normRole(request.resource.data.get('role', '')) in [
              'caissier', 'comptable', 'verificateur', 'viewer', 'uploader', 'responsable_location', 'location'
            ];
          allow delete: if isComptaAccountingWriter(orgId, comptaId);
        }

        // Locations de locaux (responsable des locations, caissier, admin)
        match /rentals/{rentalId} {
          allow read: if canReadCompta(orgId, comptaId) || isComptaRentalManager(orgId, comptaId);
          allow write: if isComptaAccountingWriter(orgId, comptaId) || isComptaRentalManager(orgId, comptaId);
        }

        // Justificatifs : un uploader crée et relit uniquement ses propres envois ;
        // un lecteur lit uniquement ; un vérificateur peut lier une pièce ; un caissier/admin gère tout.
        match /receipts/{receiptId} {
          allow read: if canReadCompta(orgId, comptaId)
            || ((isComptaUploader(orgId, comptaId) || isComptaRentalManager(orgId, comptaId))
              && resource != null
              && resource.data.get('submittedByUid', '') == request.auth.uid)
            || (resource == null && isOrgCaissier(orgId));
          allow create: if isComptaAccountingWriter(orgId, comptaId)
            || ((isComptaUploader(orgId, comptaId) || isComptaRentalManager(orgId, comptaId)) && isValidUploaderReceipt())
            || (isOrgCaissier(orgId) && (
              request.resource.data.get('submittedByUid', '') == request.auth.uid
              || 'transferRequest' in request.resource.data
            ));
          allow update: if isComptaAccountingWriter(orgId, comptaId)
            || (isComptaVerificateur(orgId, comptaId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedTransactionId']));
          allow delete: if isComptaAccountingWriter(orgId, comptaId);
        }
      }
    }

    // Autoriser la recherche de tous les rôles d'un utilisateur (collectionGroup 'members' & 'invitations')
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/invitations/{inviteId} {
      allow read: if isAuthenticated();
    }

    // File d'attente d'envoi d'e-mails (locations, rappels 5j, synthèse remboursements vendredi 12h)
    match /mail/{mailId} {
      allow create, read: if isAuthenticated();
    }
  }
}
