rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Allow all authenticated users to read user profiles (needed for member/role assignment),
    // and only the owner to write their own profile.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(userId);
      
      // Allow access to personal subcollections (legacy accounts, transactions, receipts) only to owner
      match /{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Phase 2 : Organisations
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAuthenticated();
      
      match /{document=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Autoriser la recherche de tous les rôles d'un utilisateur (collectionGroup 'members' & 'invitations')
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/invitations/{inviteId} {
      allow read: if isAuthenticated();
    }
  }
}
