rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if the user is accessing their own data
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // ------------------------------------------------------------------
    // SEC-01 : Rôle "uploader" (Déposant de factures - App Mobile)
    // Un utilisateur dont le rôle sur une comptabilité est "uploader" peut
    // CRÉER des justificatifs (et relire uniquement ses propres envois) mais
    // ne peut ni modifier ni supprimer les écritures, comptes, paramètres ou
    // membres de cette comptabilité.
    // Le rôle est lu dans :
    //   - organizations/{orgId}/comptabilites/{comptaId}/members/{uid}.role
    //   - organizations/{orgId}/members/{uid | email}.comptaAccess[comptaId]
    // Si l'une de ces sources indique "uploader", les restrictions s'appliquent
    // (sauf pour un admin d'organisation ou un super-admin).
    // ------------------------------------------------------------------

    function authEmail() {
      return ('email' in request.auth.token) ? request.auth.token.email.lower() : '';
    }

    function normRole(value) {
      return value is string ? value.trim().lower() : '';
    }

    function orgMemberPathByUid(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid);
    }

    function orgMemberPathByEmail(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/members/$(authEmail());
    }

    function comptaSubRole(orgId, comptaId) {
      let path = /databases/$(database)/documents/organizations/$(orgId)/comptabilites/$(comptaId)/members/$(request.auth.uid);
      return exists(path) ? normRole(get(path).data.get('role', '')) : '';
    }

    // comptaAccess peut être absent ou null sur d'anciennes fiches : on retombe alors sur une map vide
    function comptaAccessOf(data) {
      return data.get('comptaAccess', {}) is map ? data.get('comptaAccess', {}) : {};
    }

    function orgMemberAccessRole(path, comptaId) {
      return exists(path) ? normRole(comptaAccessOf(get(path).data).get(comptaId, '')) : '';
    }

    function orgMemberOrgRole(path) {
      return exists(path) ? normRole(get(path).data.get('role', '')) : '';
    }

    function isOrgAdmin(orgId) {
      return orgMemberOrgRole(orgMemberPathByUid(orgId)) == 'admin'
        || (authEmail() != '' && orgMemberOrgRole(orgMemberPathByEmail(orgId)) == 'admin');
    }

    function hasUploaderRole(orgId, comptaId) {
      return comptaSubRole(orgId, comptaId) == 'uploader'
        || orgMemberAccessRole(orgMemberPathByUid(orgId), comptaId) == 'uploader'
        || (authEmail() != '' && orgMemberAccessRole(orgMemberPathByEmail(orgId), comptaId) == 'uploader');
    }

    // true si l'utilisateur est "uploader" sur cette comptabilité et n'a aucun rôle supérieur
    function isUploaderOnly(orgId, comptaId) {
      return isAuthenticated()
        && request.auth.token.get('superAdmin', false) != true
        && hasUploaderRole(orgId, comptaId)
        && !isOrgAdmin(orgId);
    }

    // Un uploader ne peut pas modifier son propre profil membre (anti-élévation de privilèges)
    function isRestrictedSelfMember(memberId) {
      return (memberId == request.auth.uid || (authEmail() != '' && memberId == authEmail()))
        && resource.data.get('role', '') != 'admin'
        && comptaAccessOf(resource.data).values().hasAny(['uploader']);
    }

    // Contraintes sur un justificatif créé par un uploader : rattaché à son auteur, jamais pré-traité
    function isValidUploaderReceipt() {
      let data = request.resource.data;
      return data.get('submittedByUid', '') == request.auth.uid
        && !data.keys().hasAny(['reimbursedAt', 'reimbursedByUid', 'reimbursedByName', 'transferRequest', 'transferHistory'])
        && data.get('reimbursementStatus', null) in ['PENDING', null]
        && data.get('linkedTransactionId', null) == null;
    }

    // Allow all authenticated users to read user profiles (needed for member/role assignment),
    // and only the owner to write their own profile (or auto-purge of unverified robot accounts).
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && (
        isOwner(userId) ||
        (resource.data.emailVerificationRequired == true && resource.data.emailVerified == false)
      );
      
      // Allow access to personal subcollections (legacy accounts, transactions, receipts) only to owner
      match /{document=**} {
        allow read, write: if isAuthenticated() && isOwner(userId);
      }
    }

    // Phase 2 : Organisations
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAuthenticated();

      match /members/{memberId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && !isRestrictedSelfMember(memberId);
      }

      match /invitations/{inviteId} {
        allow read, write: if isAuthenticated();
      }

      match /comptabilites/{comptaId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && !isUploaderOnly(orgId, comptaId);

        // Sous-collections génériques (accounts, transactions, settings, categories...)
        match /{sub}/{docId=**} {
          allow read: if isAuthenticated() && sub != 'receipts';
          allow write: if isAuthenticated()
            && sub != 'receipts'
            && sub != 'members'
            && !isUploaderOnly(orgId, comptaId);
        }

        // Membres de la comptabilité (rôles) : un uploader ne peut pas s'auto-promouvoir
        match /members/{memberUid} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated() && !isUploaderOnly(orgId, comptaId);
        }

        // Justificatifs : un uploader crée et relit uniquement ses propres envois
        match /receipts/{receiptId} {
          allow read: if isAuthenticated() && (
            !isUploaderOnly(orgId, comptaId) ||
            resource.data.get('submittedByUid', '') == request.auth.uid
          );
          allow create: if isAuthenticated() && (
            !isUploaderOnly(orgId, comptaId) || isValidUploaderReceipt()
          );
          allow update, delete: if isAuthenticated() && !isUploaderOnly(orgId, comptaId);
        }
      }
    }

    // Autoriser la recherche de tous les rôles d'un utilisateur (collectionGroup 'members' & 'invitations')
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/invitations/{inviteId} {
      allow read: if isAuthenticated();
    }
  }
}
